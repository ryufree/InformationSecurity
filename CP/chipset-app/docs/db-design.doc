<!-- ══ 표지 ══ -->
<div class="cover">
  <h1>Chipset DB 설계 문서</h1>
  <p class="meta">버전 1.0 &nbsp;|&nbsp; 작성일: 2026-04-22 &nbsp;|&nbsp; 시스템: chipset-app</p>
