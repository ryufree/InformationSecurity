<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="maru.platform.mapper.PropertiesMapper">

    <select id="findByKey" resultType="maru.platform.dto.PropertiesResult">
        SELECT
            refrc1,
            refrc2,
            refrc3
        FROM
            maru_pl_comm_cd
        WHERE
            comm_type_cd = 'MARU_PROPERTIES'
            AND del_yn = 0
            AND refrc1 = #{key}
    </select>

</mapper>
